# All variables are optional; the values shown are the defaults.
MCP_TRANSPORT=stdio                # stdio | streamable-http
HOST=0.0.0.0                       # streamable-http only
PORT=8000                          # streamable-http only
LOG_LEVEL=INFO                     # DEBUG | INFO | WARN | ERROR
API_HOST=https://jsonplaceholder.typicode.com
HTTP_TIMEOUT_SECONDS=10            # per upstream request, 1-120

# Observability. Unset means inert: with neither an OTLP endpoint nor a metrics
# port, no telemetry providers are installed.
# OTEL_SERVICE_NAME=jsonplaceholder-mcp-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # traces; unset = no export
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf           # grpc (default) | http/protobuf
# METRICS_PORT=9464                                   # Prometheus /metrics listener; unset = none
